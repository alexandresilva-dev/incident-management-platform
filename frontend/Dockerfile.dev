# Imagem de DESENVOLVIMENTO do frontend (servidor Vite com hot reload).
FROM node:26-alpine

WORKDIR /app
RUN chown node:node /app
USER node

# As dependências instalam-se numa camada própria: só voltam a instalar se o
# package.json / package-lock.json mudarem (mesma ideia do backend).
COPY --chown=node:node package.json package-lock.json ./
RUN npm ci

COPY --chown=node:node . .

EXPOSE 5173
CMD ["npm", "run", "dev"]
