# Copia este ficheiro para .env e altera os valores (cp .env.example .env).
# O .env NUNCA vai para o Git; este .env.example (sem segredos reais) vai.

# --- PostgreSQL ---
POSTGRES_USER=incident_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=incident_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Porta exposta no teu Mac (para DBeaver/psql). Dentro do Docker é sempre 5432.
POSTGRES_HOST_PORT=5433

# --- API ---
# Origens autorizadas a chamar a API a partir de um browser (separadas por vírgula).
CORS_ORIGINS=http://localhost:5173

# --- Auth ---
# Assina os tokens JWT. Gera um valor com:  openssl rand -hex 32
# A app recusa arrancar com este valor de exemplo ou com menos de 32 caracteres.
SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Limite de tentativas de login falhadas dentro da janela (valores por omissão abaixo).
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_LOCKOUT_WINDOW_MINUTES=15

# --- Utilizador de demonstração ---
# Só é usado por `python -m scripts.seed`. Serve APENAS para demonstração local:
# nunca uses estas credenciais fora do teu computador.
SEED_USER_EMAIL=demo@example.com
SEED_USER_PASSWORD=demo-password-change-me
