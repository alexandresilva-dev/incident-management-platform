# Copia este ficheiro para .env e altera os valores (cp .env.example .env).
# O .env NUNCA vai para o Git; este .env.example (sem segredos reais) vai.

# --- PostgreSQL ---
POSTGRES_USER=incident_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=incident_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Porta exposta no teu Mac (para DBeaver/psql). Dentro do Docker é sempre 5432.
POSTGRES_HOST_PORT=5433

# --- API ---
# Origens autorizadas a chamar a API a partir de um browser (separadas por vírgula).
CORS_ORIGINS=http://localhost:5173
